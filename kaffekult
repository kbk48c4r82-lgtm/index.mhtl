<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="KaffeeKult in Neuwied: frisch gerösteter Kaffee, hausgemachter Kuchen und eine gemütliche Auszeit.">
  <meta name="theme-color" content="#f5efe6">
  <title>KaffeeKult – Kaffee, Kuchen & gute Zeit in Neuwied</title>
  <style>
    :root { --ink:#2d211a; --muted:#76685c; --coffee:#71452e; --cream:#f5efe6; --cream-dark:#e9ddce; --orange:#d8894e; --white:#fffdf9; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; color:var(--ink); background:var(--cream); font:16px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif; }
    a { color:inherit; }
    .wrap { width:min(1120px, calc(100% - 40px)); margin:auto; }
    header { padding:20px 0; }
    .nav { display:flex; align-items:center; justify-content:space-between; gap:24px; }
    .brand { display:flex; align-items:center; gap:10px; text-decoration:none; font-weight:850; letter-spacing:-.04em; font-size:1.2rem; }
    .brand-mark { width:34px; height:34px; display:grid; place-items:center; background:var(--coffee); color:var(--cream); border-radius:50%; font-size:1.15rem; }
    nav { display:flex; gap:26px; }
    nav a { text-decoration:none; color:var(--muted); font-size:.94rem; }
    nav a:hover { color:var(--coffee); }

    .hero { min-height:540px; padding:66px 0 82px; display:grid; grid-template-columns:1.1fr .9fr; align-items:center; gap:55px; position:relative; isolation:isolate; }
    .bean-flight { position:absolute; z-index:0; top:5px; width:90px; height:54px; pointer-events:none; }
    .bean-flight.left { left:3%; }
    .bean-flight.right { right:5%; transform:scaleX(-1); }
    .hero > :not(.bean-flight) { position:relative; z-index:1; }
    .bean { position:absolute; width:17px; height:25px; border-radius:50% 50% 48% 48%; background:linear-gradient(135deg,#9a6240,#60351f 70%); box-shadow:inset 2px 1px 2px #d09a6a66,0 2px 4px #43271820; animation:bean-drift 3.8s ease-in-out infinite,bean-fade 6s linear infinite; }
    .bean::after { content:""; position:absolute; left:7px; top:3px; width:4px; height:19px; border-left:1.5px solid #e0b58caa; border-radius:50%; transform:rotate(12deg); }
    .bean:nth-child(1) { left:4px; top:16px; transform:rotate(-38deg); animation-delay:-1.4s,0s; }
    .bean:nth-child(2) { left:39px; top:3px; transform:rotate(24deg) scale(.78); animation:bean-drift 3.8s ease-in-out infinite,bean-fade 6s linear infinite; animation-delay:-.4s,1s; }
    .bean:nth-child(3) { left:67px; top:23px; transform:rotate(55deg) scale(.62); animation:bean-drift 3.8s ease-in-out infinite,bean-fade 6s linear infinite; animation-delay:-2.2s,2s; }
    .bean-flight.right .bean:nth-child(1) { animation-delay:-1.4s,3s; }
    .bean-flight.right .bean:nth-child(2) { animation-delay:-.4s,4s; }
    .bean-flight.right .bean:nth-child(3) { animation-delay:-2.2s,5s; }
    @keyframes bean-drift { 0%,100% { translate:0 0; rotate:0deg; } 50% { translate:10px -9px; rotate:24deg; } }
    @keyframes bean-fade { 0%,27% { opacity:1; } 35%,100% { opacity:0; } }

    .review-cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
    .review-card { padding:17px; border-radius:16px; background:var(--cream); border:1px solid #e1d3c4; }
    .review-card .stars { font-size:.92rem; }
    .review-card blockquote { margin:9px 0 13px; font-family:Georgia,serif; font-size:1.03rem; line-height:1.4; }
    .review-card small { color:var(--muted); }
    @media(max-width:760px) { .review-cards { grid-template-columns:1fr; } }
    @media(prefers-reduced-motion:reduce) { .bean { animation:none; } }

    .eyebrow { color:var(--coffee); font-weight:750; text-transform:uppercase; letter-spacing:.14em; font-size:.76rem; }
    h1 { font-family:Georgia,serif; font-weight:500; font-size:clamp(2.35rem,5vw,4.3rem); line-height:1.04; letter-spacing:-.05em; margin:18px 0 22px; max-width:720px; }
    .lead { font-size:1.15rem; color:var(--muted); max-width:540px; }
    .actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:30px; }
    .button { display:inline-block; border-radius:999px; padding:13px 21px; font-weight:700; text-decoration:none; background:var(--coffee); color:white; transition:transform .18s,background .18s; }
    .button:hover { transform:translateY(-2px); background:#56321f; }
    .button.secondary { background:transparent; color:var(--coffee); border:1px solid #c6ad98; }
    .hero-art { min-height:390px; border-radius:50% 50% 20px 20px / 40% 40% 20px 20px; position:relative; overflow:hidden; background:var(--cream-dark); box-shadow:0 24px 55px #43271822; }
    .hero-art img { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; }
    section { padding:76px 0; }
    .section-title { font-family:Georgia,serif; font-size:clamp(2.2rem,4vw,3.4rem); font-weight:500; line-height:1.08; letter-spacing:-.045em; margin:8px 0 17px; }
    .intro { max-width:660px; color:var(--muted); font-size:1.06rem; }
    .cards { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:35px; }
    .card { background:var(--white); padding:27px; border-radius:18px; border:1px solid #eadfd3; }
    .card .icon { width:45px; height:45px; display:grid; place-items:center; background:#f2e6d8; border-radius:50%; font-size:1.3rem; }
    .card h3 { margin:15px 0 7px; font-family:Georgia,serif; font-size:1.35rem; font-weight:500; }
    .card p { color:var(--muted); margin:0; }
    .gallery { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-top:34px; }
    .gallery figure { margin:0; overflow:hidden; border-radius:18px; position:relative; background:var(--cream-dark); }
    .gallery img { width:100%; aspect-ratio:4/3; object-fit:cover; display:block; transition:transform .4s; }
    .gallery figure:hover img { transform:scale(1.035); }
    .gallery figcaption { position:absolute; left:12px; bottom:12px; border-radius:999px; padding:6px 11px; background:#fffdf9e8; font-size:.8rem; }

    .review { background:#ede1d3; }
    .review-grid { display:grid; grid-template-columns:.8fr 1.2fr; gap:56px; align-items:center; }
    .rating { font-family:Georgia,serif; font-size:4rem; line-height:1; color:var(--coffee); }
    .stars { color:#b76a27; letter-spacing:.12em; font-size:1.25rem; }
    .review-text { font-family:Georgia,serif; font-size:1.5rem; line-height:1.4; }
    .review small { color:var(--muted); }

    .contact-box { background:var(--coffee); color:white; border-radius:26px; padding:44px; display:flex; justify-content:space-between; align-items:center; gap:30px; }
    .contact-box p { color:#f0ded0; margin-bottom:0; }
    .contact-box .button { background:#f0c89e; color:var(--ink); white-space:nowrap; }
    .contact-box .button:hover { background:#ffdbb5; }
    .contact-box .section-title { margin-bottom:6px; }
    .address { font-size:1.05rem; }
    .map-card { overflow:hidden; border-radius:22px; border:1px solid #e1d3c4; box-shadow:0 16px 38px #43271812; background:var(--cream-dark); }
    .map-card iframe { display:block; width:100%; border:0; }
    .visit-layout { display:grid; grid-template-columns:.9fr 1.1fr; gap:20px; align-items:stretch; }
    .map-card { margin-top:0; }
    .map-card iframe { height:360px; }
    .visit-info { background:var(--coffee); color:white; border-radius:22px; padding:32px; }
    .visit-info .section-title { margin:6px 0 22px; }
    .visit-info .eyebrow { color:#f0c89e; }
    .visit-detail { padding:12px 0; border-top:1px solid #ffffff35; }
    .visit-detail strong { display:block; color:#f0c89e; font-size:.82rem; text-transform:uppercase; letter-spacing:.08em; }
    .visit-detail a { color:white; text-underline-offset:3px; }
    .visit-info .button { margin-top:20px; background:#f0c89e; color:var(--ink); }

    @media(max-width:760px) {
      .visit-layout { grid-template-columns:1fr; }
      .map-card iframe { height:280px; }
      .visit-info { padding:28px; }
    }

    footer { padding:27px 0; color:var(--muted); font-size:.9rem; }
    footer .wrap { display:flex; justify-content:space-between; gap:15px; flex-wrap:wrap; }
    footer a { text-underline-offset:3px; }

    @media(max-width:760px) {
      .hero,.review-grid { grid-template-columns:1fr; }
      .hero { padding-top:44px; gap:30px; }
      .hero-art { min-height:290px; }
      .cards { grid-template-columns:1fr; }
      .gallery { grid-template-columns:repeat(2,minmax(0,1fr)); }
      nav { gap:14px; }
      .contact-box { padding:30px; display:block; }
      .contact-box .button { margin-top:22px; }
    }
    @media(max-width:430px) {
      .wrap { width:min(100% - 28px,1120px); }
      nav a { font-size:.84rem; }
      .brand { font-size:1.05rem; }
    }
  </style>
